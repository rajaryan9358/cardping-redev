# Copy to .env and fill in. Never commit the real .env.

PORT=3200
NODE_ENV=production

# Same Supabase project as server/ — admin/ talks to it directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paths to the sibling apps' .env files, used by the Env Variables screen and
# to read secrets (OpenAI, WhatsApp, Telegram) at call time without
# duplicating them into this app's own .env. Relative to admin/'s cwd —
# defaults assume /var/www/cardping/{server,dashboard,admin} siblings.
SERVER_ENV_PATH=../server/.env
DASHBOARD_ENV_PATH=../dashboard/.env

# server/'s /health endpoint, polled by the Bot/Scan Health screen.
SERVER_HEALTH_URL=http://127.0.0.1:3000/health

SESSION_COOKIE_NAME=cardping_admin_session
SESSION_TTL_HOURS=168

# Proactive WhatsApp notifications — approved Utility-category template
# names (Meta Business Manager → WhatsApp Manager → Message Templates).
WHATSAPP_RENEWAL_TEMPLATE_NAME=subscription_renewal_reminder
WHATSAPP_LOW_BALANCE_TEMPLATE_NAME=low_coin_balance_alert
RENEWAL_REMINDER_DAYS_BEFORE_EXPIRY=3
LOW_BALANCE_THRESHOLD=2
NOTIFICATION_CHECK_INTERVAL_MINUTES=60
