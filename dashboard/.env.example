# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=production

# server/'s API, called server-to-server during SSR (bypassing nginx) — see
# lib/serverFetch.ts. Client-side calls stay relative (/api/...) since
# dashboard/ and server/ share one domain in production.
SERVER_API_BASE_URL=http://127.0.0.1:3000

# Google Cloud project with Maps JavaScript API + Places API enabled and
# billing configured. Powers the event location autocomplete + embedded map
# preview (components/events/LocationAutocompleteInput.tsx, EventMap.tsx).
# Both features degrade gracefully (plain text input, no map section) when
# this is unset — leave it blank until the key is available.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
