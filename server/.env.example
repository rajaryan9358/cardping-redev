# ─────────────────────────────────────────────────────────────────────────
# CardPing server — environment configuration
# Copy this file to `.env` and fill in real values. See docs/ENVIRONMENT.md
# for a full explanation of every variable.
# ─────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
PORT=3000
# Public base URL this server is reachable at (used to build the Google
# OAuth redirect URI and to log webhook URLs). No trailing slash.
PUBLIC_BASE_URL=https://your-domain.example.com
LOG_LEVEL=info

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Service-role key. Full DB + storage access — never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_CARDS=visiting-cards
SUPABASE_STORAGE_BUCKET_VOICE=voice-notes

# --- WhatsApp Cloud API (Meta) ---------------------------------------------
# Permanent access token for a Meta System User (Business Settings > System
# Users). Do NOT use a temporary 24h token in production.
WHATSAPP_ACCESS_TOKEN=
# Any string you choose. Must match the "Verify token" you enter in the
# Meta App Dashboard webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Default phone_number_id to send from when there is no inbound message to
# reply to (e.g. server-initiated flows). Normal replies use the
# phone_number_id from the inbound webhook automatically.
WHATSAPP_PHONE_NUMBER_ID=
# App secret from the Meta App Dashboard, used to verify the
# X-Hub-Signature-256 header on inbound webhooks. Strongly recommended.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0
# WABA ID (Meta Business Manager > WhatsApp Manager > API Setup) — distinct
# from WHATSAPP_PHONE_NUMBER_ID. server/ never reads this itself; it's read
# from here by admin/ to populate the template dropdown on Broadcasts/Send
# Message. Optional — those screens fall back to manual entry without it.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Telegram Bot API ---------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Shared secret sent back by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header, used to verify inbound webhook calls. Any string you choose.
TELEGRAM_WEBHOOK_SECRET=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Coins / billing --------------------------------------------------------
COINS_PER_CARD_SCAN=1
COINS_STARTER_BALANCE=5

# --- Google OAuth (dashboard/ "Continue with Google" login) ----------------
# Shared client with GOOGLE_DASHBOARD_OAUTH_REDIRECT_URI below — see that
# var's comment for the redirect URI itself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cashfree Payment Links (coin top-up) -----------------------------------
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# https://sandbox.cashfree.com/pg for testing, https://api.cashfree.com/pg for production
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
# Where Cashfree redirects the payer after paying — dashboard/'s generic
# "payment received, confirming now" page (the actual credit happens via
# the webhook above, not this redirect).
CASHFREE_RETURN_URL=https://your-domain.example.com/subscription/success
# Coins credited per successful top-up link, and the amount charged (INR).
COIN_TOPUP_AMOUNT_INR=1000
COIN_TOPUP_COINS=50

# --- dashboard/ auth (see docs/DASHBOARD_PLAN.md) --------------------------
SESSION_COOKIE_NAME=cardping_session
SESSION_TTL_HOURS=720
# "Authorized redirect URI" on the GOOGLE_CLIENT_ID client above, e.g.
# https://your-domain.example.com/api/auth/google/callback.
# Google login is disabled until this is set.
GOOGLE_DASHBOARD_OAUTH_REDIRECT_URI=
# Name of a Meta Business Manager Authentication-category template,
# approved for sending OTP codes. WhatsApp OTP login/channel-linking is
# disabled until this is set.
WHATSAPP_LOGIN_OTP_TEMPLATE_NAME=
# Optional — defaults to WHATSAPP_LOGIN_OTP_TEMPLATE_NAME if left blank.
# Only set separately if Meta's review requires a distinct template per
# use case.
WHATSAPP_CHANNEL_LINK_OTP_TEMPLATE_NAME=
# Public @username of the Telegram bot, without the @ — needed to build
# the t.me/<bot>?start=<code> channel-link deep link.
TELEGRAM_BOT_USERNAME=
# Optional — defaults to PUBLIC_BASE_URL if left blank (dashboard/ and
# server/ share one origin in production). Base URL for the "complete your
# account" link the bot sends an unlinked WhatsApp/Telegram user. Only
# needs setting explicitly in a local setup where dashboard/ runs on a
# different port with no shared reverse proxy.
DASHBOARD_BASE_URL=
